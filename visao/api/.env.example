# Copie este arquivo para .env (mesma pasta) e preencha. O .env NUNCA vai para o GitHub.
# Chave gratuita: https://aistudio.google.com (Get API key). Cada integrante pode usar a sua.
GEMINI_API_KEY=cole_sua_chave_aqui

# Opcionais (sem a linha, vale o padrao entre parenteses)
# Modelo principal e reserva do assistente (gemini-3.8-flash e gemini-3.5-flash)
# GEMINI_MODELO=gemini-3.8-flash
# GEMINI_MODELO_RESERVA=gemini-3.5-flash
# GEMINI_MODELO_RESERVA_2=gemini-3.5-flash-lite
# Perguntas por minuto por IP ao assistente (PROPOSTA: 5)
# ASSISTENTE_LIMITE_POR_MINUTO=5
# Enderecos do app que podem chamar a API pelo navegador (CORS), separados por virgula
# ORIGENS_PERMITIDAS=http://localhost:5173,http://localhost:3000
# MQTT: 0 desliga a publicacao para o ESP32 (1)
# MQTT_ATIVO=1
